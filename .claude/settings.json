      "Bash(git *remote set-url*)",
      "Bash(git *remote remove*)",

      "Bash(gh *create*)",
      "Bash(gh *delete*)",
      "Bash(gh *edit*)",
      "Bash(gh *merge*)",
      "Bash(gh *close*)",
      "Bash(gh *reopen*)",
      "Bash(gh *comment*)",
      "Bash(gh *review*)",
      "Bash(gh *secret*)",
      "Bash(gh *set*)",
      "Bash(gh *workflow run*)",
      "Bash(gh *workflow enable*)",
