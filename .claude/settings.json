      "Read(~/.aws/login/cache/**)",
      "Read(~/.aws/credentials)",
      "Read(~/.ssh/**)",
      "Read(~/.config/gh/**)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/*.tfstate)",
      "Read(**/*.tfstate.*)"
