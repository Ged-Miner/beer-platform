      "Bash(aws *put-*)",
      "Bash(aws *update-*)",
      "Bash(aws *modify-*)",
      "Bash(aws *attach-*)",
      "Bash(aws *detach-*)",
      "Bash(aws *associate-*)",
      "Bash(aws *tag-*)",
      "Bash(aws *set-*)",
      "Bash(aws *add-*)",
      "Bash(aws *remove-*)",
      "Bash(aws *register-*)",
      "Bash(aws *enable-*)",
      "Bash(aws *disable-*)",
      "Bash(aws *start-*)",
      "Bash(aws *stop-*)",
      "Bash(aws *run-*)",
      "Bash(aws *terminate-*)",
      "Bash(aws *reboot-*)",
      "Bash(aws *restore-*)",
      "Bash(aws *import-*)",
      "Bash(aws *cancel-*)",
      "Bash(aws *upload-*)",
      "Bash(aws *reset-*)",
      "Bash(aws *apply-*)",
      "Bash(aws *send-*)",
      "Bash(aws *publish*)",
      "Bash(aws *invoke*)",
      "Bash(aws *deploy*)",
      "Bash(aws *s3 cp*)",
      "Bash(aws *s3 mv*)",
      "Bash(aws *s3 rm*)",
      "Bash(aws *s3 sync*)",
      "Bash(aws *s3 mb*)",
      "Bash(aws *s3 rb*)",
      "Bash(aws *assume-role*)",
      "Bash(aws *get-login-password*)",
      "Bash(aws *export-credentials*)",
      "Bash(aws configure*)",

      "Bash(git *add *)",
      "Bash(git *commit*)",
      "Bash(git *push*)",
      "Bash(git *merge*)",
      "Bash(git *rebase*)",
      "Bash(git *reset*)",
      "Bash(git *revert*)",
